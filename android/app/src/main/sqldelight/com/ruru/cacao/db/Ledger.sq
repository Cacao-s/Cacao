insertMember:
INSERT INTO member(id, role, name, birthday, avatar_color, pin_hash, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertEntry:
INSERT INTO ledger_entry(id, group_id, child_id, account, kind, amount, occurred_on, source_id, goal_id, note, message, recorded_by, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertAllowanceEntry:
INSERT OR IGNORE INTO ledger_entry(id, group_id, child_id, account, kind, amount, occurred_on, source_id, allowance_id, allowance_due, created_at)
VALUES (?, ?, ?, 'savings', 'income_allowance', ?, ?, ?, ?, ?, ?);

voidGroup:
INSERT INTO ledger_void(id, group_id, voided_by, created_at)
VALUES (?, ?, ?, ?);

balance:
SELECT CAST(COALESCE(SUM(amount), 0) AS INTEGER)
FROM ledger_entry
WHERE child_id = ? AND account = ? AND group_id NOT IN (SELECT group_id FROM ledger_void);

children:
SELECT * FROM member WHERE role = 'child' AND deleted_at IS NULL ORDER BY sort_order;

entriesForChild:
SELECT e.*, (SELECT COUNT(*) FROM ledger_void v WHERE v.group_id = e.group_id) AS voided
FROM ledger_entry e
WHERE e.child_id = ?
ORDER BY e.occurred_on DESC, e.created_at DESC;

voidedGroupsForChild:
SELECT v.group_id FROM ledger_void v
WHERE v.group_id IN (SELECT group_id FROM ledger_entry WHERE child_id = ?);

groupEntries:
SELECT * FROM ledger_entry WHERE group_id = ?;

incomeBetween:
SELECT CAST(COALESCE(SUM(amount), 0) AS INTEGER) FROM ledger_entry
WHERE child_id = ? AND account = 'savings' AND kind LIKE 'income_%'
  AND occurred_on >= ? AND occurred_on < ?
  AND group_id NOT IN (SELECT group_id FROM ledger_void);

tasksBetween:
SELECT COUNT(*) FROM task_completion c JOIN task t ON t.id = c.task_id
WHERE t.child_id = ? AND substr(c.completed_at, 1, 10) >= ? AND substr(c.completed_at, 1, 10) < ?;

goalsCompletedBetween:
SELECT COUNT(DISTINCT e.goal_id) FROM goal_event e JOIN goal g ON g.id = e.goal_id
WHERE g.child_id = ? AND e.kind = 'completed'
  AND substr(e.created_at, 1, 10) >= ? AND substr(e.created_at, 1, 10) < ?
  AND (e.ledger_group_id IS NULL OR e.ledger_group_id NOT IN (SELECT group_id FROM ledger_void));
